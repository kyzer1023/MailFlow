{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailflow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailflow-db",
      "database_id": "5a27ec3b-bd7d-4b45-be6d-10ad59aeb9de",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "mailflow-attachments"
    }
  ],
  "triggers": {
    "crons": ["15 * * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "CAMPAIGN_QUEUE",
        "queue": "mailflow-campaign-ticks"
      }
    ],
    "consumers": [
      {
        "queue": "mailflow-campaign-ticks",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://mailflow.kyzer-hono-test.workers.dev",
    "ENTRA_TENANT_ID": "0ad0fbf8-69ca-4e5e-afad-cd70424ac626",
    "ENTRA_CLIENT_ID": "20936b15-0b73-47f5-912f-737eab3de293",
    "DEFAULT_CAMPAIGN_PACE": "12",
    "MAX_CAMPAIGN_RECIPIENTS": "300"
  }
}
