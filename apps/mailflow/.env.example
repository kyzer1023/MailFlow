# Public, non-secret application configuration may also be declared in
# wrangler.jsonc. Keep this file as a complete local-development reference.
PUBLIC_ORIGIN=http://localhost:5173
ENTRA_TENANT_ID=replace-with-usm-tenant-id
ENTRA_CLIENT_ID=replace-with-mailflow-client-id
DEFAULT_CAMPAIGN_PACE=12
MAX_CAMPAIGN_RECIPIENTS=300

# Secrets. Use `wrangler secret put` in production.
ENTRA_CLIENT_SECRET=replace-locally
TOKEN_ENCRYPTION_KEY_B64=replace-with-32-byte-base64-key
SESSION_SECRET=replace-with-long-random-value

